{
  "version": 2,
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.8.0" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(build|css|js|images|img|assets|storage|fonts)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}